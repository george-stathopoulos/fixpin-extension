{
  "manifest_version": 3,
  "name": "FixPin: show support where it breaks",
  "short_name": "FixPin",
  "version": "0.1.1",
  "description": "Point at a problem on any web page and share a private, expiring link with the screenshot, the spot, and any errors.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Spotlight a problem", "default_popup": "src/popup.html" },
  "permissions": [ "activeTab", "scripting", "storage" ],
  "background": { "service_worker": "src/background.js", "type": "module", "scripts": [ "src/background.js" ] },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Spotlight a problem" } },
  "browser_specific_settings": { "gecko": { "id": "fixpin@george-stathopoulos.github.io", "strict_min_version": "128.0", "data_collection_permissions": { "required": [ "websiteContent" ] } } }
}
